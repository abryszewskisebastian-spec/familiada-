<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8">
<title>Familiada - Pełna Gra</title>
<style>
body {
    margin: 0;
    background: #0a1e24;
    font-family: Arial, sans-serif;
    color: #fff;
}
.top {
    text-align: center;
    font-size: 32px;
    padding: 20px;
    background: #12343b;
}
.container {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 20px;
    flex-wrap: wrap;
}
.team {
    width: 20%;
    text-align: center;
    min-width: 150px;
}
.team.red { color: #ff4c4c; }
.team.blue { color: #4ca3ff; }
.strikes span {
    font-size: 48px;
    opacity: .2;
    display: inline-block;
    margin: 0 2px;
}
.strikes .on { opacity: 1; }
.board {
    width: 55%;
    min-width: 300px;
    background: #143a42;
    border-radius: 25px;
    padding: 20px;
    box-sizing: border-box;
}
.question {
    text-align: center;
    font-size: 26px;
    margin-bottom: 20px;
}
.answers {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
}
.answer {
    background: #1e5661;
    padding: 15px;
    border-radius: 15px;
    font-size: 20px;
    display: flex;
    justify-content: space-between;
    cursor: pointer;
    transition: 0.3s;
}
.answer.correct { background: #2e7d32; }
.answer.hidden span:first-child { visibility: hidden; }
.footer { text-align: center; font-size: 22px; margin-top: 15px; }
.controls {
    text-align: center;
    padding: 15px;
    flex-basis: 100%;
}
.controls button {
    margin: 5px;
    padding: 10px 15px;
    border-radius: 12px;
    border: none;
    cursor: pointer;
}
.red { background: #a00000; color: #fff; }
.blue { background: #003c8f; color: #fff; }
.gray { background: #555; color: #fff; }
@media(max-width:800px){
    .container{flex-direction:column; align-items:center;}
    .board{width:90%; margin:10px 0;}
}
</style>
</head>
<body>

<div class="top">FAMILIADA</div>

<div class="container">
    <div class="team red">
        <h2>CZERWONI</h2>
        <div class="strikes">
            <span id="xr1">X</span><span id="xr2">X</span><span id="xr3">X</span>
        </div>
        <h3 id="scoreRed">0</h3>
    </div>

    <div class="board">
        <div class="question" id="question"></div>
        <div class="answers" id="answers"></div>
        <div class="footer">PUNKTY RUNDY: <span id="round">0</span></div>
    </div>

    <div class="team blue">
        <h2>NIEBIESCY</h2>
        <div class="strikes">
            <span id="xb1">X</span><span id="xb2">X</span><span id="xb3">X</span>
        </div>
        <h3 id="scoreBlue">0</h3>
    </div>
</div>

<div class="controls">
    <button onclick="setMode('host')" class="gray">TRYB HOST</button>
    <button onclick="setMode('tv')" class="gray">TRYB TV</button><br>
    <button onclick="strike('red')" class="red">X CZERWONI</button>
    <button onclick="strike('blue')" class="blue">X NIEBIESCY</button><br>
    <button onclick="givePoints('red')" class="red">PUNKTY → CZERWONI</button>
    <button onclick="givePoints('blue')" class="blue">PUNKTY → NIEBIESCY</button><br>
    <button onclick="revealAll()" class="gray">ODKRYJ</button>
    <button onclick="nextRound()" class="gray">NOWA RUNDA</button>
    <button onclick="newGame()" class="gray">NOWA GRA</button>
</div>

<audio id="soundCorrect" src="dobra.mp3"></audio>
