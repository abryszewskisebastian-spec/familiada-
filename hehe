// --- STAN GRY ---
let mode="host";
let state={
  i:0,
  shown:Array(questions[0].a.length).fill(0),
  round:0,
  sr:0,
  sb:0,
  xr:0,
  xb:0
};

// --- FUNKCJE ---
function save(){ localStorage.setItem("fam",JSON.stringify(state)); }

function setMode(m){ mode=m; draw(); }

function draw(){
    
let q=questions[state.i];
    document.getElementById("question").innerText =
        (mode === "host") ? q.q : "";

    // punkty rundy tylko dla hosta
    document.getElementById("round").innerText =
        (mode === "host") ? state.round : "";

    document.getElementById("scoreRed").innerText=state.sr;
    document.getElementById("scoreBlue").innerText=state.sb;

    let box=document.getElementById("answers");
    box.innerHTML="";
    if(!state.shown||state.shown.length!==q.a.length) state.shown=Array(q.a.length).fill(0);

    q.a.forEach((x,i)=>{
        let d=document.createElement("div");
        d.className="answer"+(state.shown[i]?" correct":"")+( !state.shown[i]&&mode==="tv"?" hidden":"");
        d.innerHTML = `<span>${x[0]}</span><span>${mode==="host"||state.shown[i]?x[1]:""}</span>`;
        if(mode==="host"&&!state.shown[i]){
            d.onclick=()=>{ 
                state.shown[i]=1;
                state.round+=x[1];
                document.getElementById("soundCorrect").currentTime=0;
                document.getElementById("soundCorrect").play();
                save();
                draw();
            };
        }
        box.appendChild(d);
    });

    ["xr","xb"].forEach((t,j)=>{
        for(let i=1;i<=3;i++)
            document.getElementById(t+i).classList.toggle("on",(j?state.xb:state.xr)>=i);
    });
}

function strike(t){
    if(t==="red" && state.xr<3) state.xr++;
    if(t==="blue" && state.xb<3) state.xb++;
    document.getElementById("soundX").currentTime=0;
    document.getElementById("soundX").play();
    save();
    draw();
}

function givePoints(t){
    if(t==="red") state.sr+=state.round;
    else state.sb+=state.round;
    state.round=0;
    save();
    draw();
}

function revealAll(){
    state.shown=Array(questions[state.i].a.length).fill(1);
    document.getElementById("soundCorrect").currentTime=0;
    document.getElementById("soundCorrect").play();
    save();
    draw();
}

function nextRound(){
    if(state.i+1>=questions.length){ alert("KONIEC GRY!"); return; }
    state.i++;
    state.shown=Array(questions[state.i].a.length).fill(0);
    state.round=0;
    state.xr=0;
    state.xb=0;
    save();
    draw();
}

function newGame(){
    state={
        i:0,
        shown:Array(questions[0].a.length).fill(0),
        round:0,
        sr:0,
        sb:0,
        xr:0,
        xb:0
    };
    save();
    draw();
}

window.addEventListener("storage",()=>{
    state=JSON.parse(localStorage.getItem("fam"));
    draw();
});
